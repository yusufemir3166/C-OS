#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "C-OS Project\0"
            VALUE "FileDescription", "C-OS Win7-style Desktop Simulator\0"
            VALUE "FileVersion", "1.1.0.0\0"
            VALUE "InternalName", "C-OS\0"
            VALUE "LegalCopyright", "(c) 2026 C-OS\0"
            VALUE "OriginalFilename", "C-OS.exe\0"
            VALUE "ProductName", "C-OS\0"
            VALUE "ProductVersion", "1.1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
